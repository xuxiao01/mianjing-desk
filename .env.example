VITE_DATA_SOURCE=api
# Development defaults to /; production uses /mianjing/ from .env.production.
# VITE_APP_BASE=/
# Same-origin /api by default. Never put secrets in VITE_* variables.
VITE_API_BASE_URL=/api
# Development proxy target only, not included in browser code.
API_PROXY_TARGET=http://127.0.0.1:3000
